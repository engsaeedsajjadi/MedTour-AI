# Not safe for production as-is. Supply unique values before first use.
APP_ENV=development
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://medtour:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@db:5432/medtour
# Tenant isolation: the API connects as the non-privileged role "medtour_app" (no superuser,
# no BYPASSRLS). docker-compose builds its DSN from this password; use 16+ letters/digits only.
APP_DB_PASSWORD=REPLACE_WITH_APP_ROLE_PASSWORD_16_PLUS_CHARS
# Owner DSN used only by the migrate service (defaults to the medtour owner above).
MIGRATION_DATABASE_URL=
# "required" makes the API refuse to start unless RLS is effective (always on in production).
RLS_ENFORCEMENT=required
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_SECRET_PASSWORD
TENANT_SLUG=medtour-local
TENANT_NAME=MedTour Local
# Host port of the web panel; CORS_ORIGINS must contain http://localhost:<WEB_PORT>.
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://redis:6379/0
PUBLIC_API_URL=http://localhost:8000
# Do NOT enable without business/geographic eligibility and documented data processing approval.
AI_PROVIDER_APPROVED=false
AI_BASE_URL=
# Exact approved HTTPS hostnames (comma-separated); use network egress/DNS controls too.
AI_APPROVED_HOSTS=
AI_MODEL=
AI_API_KEY=
WHATSAPP_BUSINESS_ELIGIBILITY_APPROVED=false
META_APP_SECRET=
META_VERIFY_TOKEN=

# Private local-only test documents: NEVER enable in production without malware scanning and reviewed object storage.
ALLOW_DEV_ENCRYPTED_UPLOADS=false
DOCUMENT_ENCRYPTION_KEY=
PRIVATE_DOCUMENT_DIR=./.private_documents
WHATSAPP_INBOUND_PROCESSING_APPROVED=false
WHATSAPP_TENANT_SLUG=
WHATSAPP_PHONE_NUMBER_ID=

# Consent links are short-lived; configure a verified privacy notice before real deployment.
PRIVACY_NOTICE_VERSION=v0-development
PUBLIC_PRIVACY_NOTICE_URL=

# S3 + malware scanner: blocked by default. Never set approval without legal and security review.
# Self-hosted option: docker compose --profile secure-storage up -d (MinIO + ClamAV), then:
#   MEDICAL_STORAGE_SELF_HOSTED=true, MEDICAL_S3_ENCRYPTION=client, MEDICAL_S3_ENDPOINT=http://minio:9000,
#   CLAMAV_HOST=clamav, and a MEDICAL_MASTER_KEY (python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
DOCUMENT_PROCESSING_APPROVED=false
MEDICAL_STORAGE_SELF_HOSTED=false
# kms = AWS S3 SSE-KMS (MEDICAL_S3_KMS_KEY_ID); client = per-document AES-256-GCM keys wrapped by MEDICAL_MASTER_KEY
MEDICAL_S3_ENCRYPTION=kms
MEDICAL_MASTER_KEY=
MEDICAL_S3_BUCKET=medtour-medical
MEDICAL_S3_REGION=us-east-1
MEDICAL_S3_KMS_KEY_ID=
MEDICAL_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Retention: days after which documents may be cryptographically erased (unset = only revoked documents).
MEDICAL_DOCUMENT_RETENTION_DAYS=

# Patient portal one-time codes: email (SMTP) or sms_webhook (adapter for Kavenegar/Twilio/...).
OTP_DELIVERY_PROVIDER=none
PUBLIC_PORTAL_URL=http://localhost:3000/patient-portal
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=

# Staff two-factor (TOTP). Required for STAFF_MFA_ROLES (admin and operator always in production).
# Set MFA_ENCRYPTION_KEY first, otherwise staff cannot enrol:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STAFF_MFA_REQUIRED=true
STAFF_MFA_ROLES=admin,operator
MFA_ENCRYPTION_KEY=

# Real-patient gate: the API refuses to start in this mode until every technical control is on
# and the references of the legal decisions below are recorded (see docs/COMMERCIAL_READINESS_FA.md).
REAL_PATIENT_DATA_MODE=false
PRIVACY_NOTICE_APPROVAL_REFERENCE=
DATA_PROTECTION_REVIEW_REFERENCE=
PROVIDER_CONTRACTS_REFERENCE=
MEDICAL_TOURISM_LICENSE_REFERENCE=

# Meta templates only; business and geographic eligibility and opt-in required.
WHATSAPP_OUTBOUND_APPROVED=false
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# Telegram Bot API (independent of WhatsApp/Meta).
# Optional, DISABLED by default. Use only official BotFather bot credentials.
# The current adapter sends privacy notices only; it NEVER stores medical chat
# content, creates patient records, or serves as secure portal authentication.
# Set a PUBLIC HTTPS privacy notice before enabling. Redis required for
# deduplication. Never commit secrets, webhook headers or bot tokens.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Local polling: explicit test-only opt-in and exactly ONE paired private chat.
# Do not use for real patient data or production. Pair with the Windows setup script.
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLLING_TEST_MODE=false
TELEGRAM_POLLING_CHAT_ID=

# Persistent SQL outbox worker is OFF unless deliberately activated in the
# Docker "messaging" profile after provider/legal/consent approvals.
OUTBOUND_WORKER_ENABLED=false
OUTBOUND_WORKER_POLL_SECONDS=5
OUTBOUND_WORKER_BATCH_SIZE=20

# Optional HTTP proxy used only by the local Telegram poller to reach api.telegram.org
# (e.g. http://host.docker.internal:10809 when a VPN client exposes an HTTP proxy on the host).
TELEGRAM_HTTPS_PROXY=

# Public link patients use to reach a human operator from the Telegram bot (https only),
# e.g. the operator's Telegram account: https://t.me/<operator_username>
PUBLIC_OPERATOR_CONTACT_URL=
