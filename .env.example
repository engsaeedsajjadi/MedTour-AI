# Not safe for production as-is. Supply unique values before first use.
APP_ENV=development
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://medtour:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@db:5432/medtour
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_SECRET_PASSWORD
TENANT_SLUG=medtour-local
TENANT_NAME=MedTour Local
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://redis:6379/0
PUBLIC_API_URL=http://localhost:8000
# Do NOT enable without business/geographic eligibility and documented data processing approval.
AI_PROVIDER_APPROVED=false
AI_BASE_URL=
# Exact approved HTTPS hostnames (comma-separated); use network egress/DNS controls too.
AI_APPROVED_HOSTS=
AI_MODEL=
AI_API_KEY=
WHATSAPP_BUSINESS_ELIGIBILITY_APPROVED=false
META_APP_SECRET=
META_VERIFY_TOKEN=

# Private local-only test documents: NEVER enable in production without malware scanning and reviewed object storage.
ALLOW_DEV_ENCRYPTED_UPLOADS=false
DOCUMENT_ENCRYPTION_KEY=
PRIVATE_DOCUMENT_DIR=./.private_documents
WHATSAPP_INBOUND_PROCESSING_APPROVED=false
WHATSAPP_TENANT_SLUG=
WHATSAPP_PHONE_NUMBER_ID=

# Consent links are short-lived; configure a verified privacy notice before real deployment.
PRIVACY_NOTICE_VERSION=v0-development
PUBLIC_PRIVACY_NOTICE_URL=

# S3 + malware scanner: blocked by default. Never set approval without legal and security review.
DOCUMENT_PROCESSING_APPROVED=false
MEDICAL_S3_BUCKET=
MEDICAL_S3_REGION=
MEDICAL_S3_KMS_KEY_ID=
MEDICAL_S3_ENDPOINT=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Meta templates only; business and geographic eligibility and opt-in required.
WHATSAPP_OUTBOUND_APPROVED=false
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# Telegram Bot API (independent of WhatsApp/Meta).
# Optional, DISABLED by default. Use only official BotFather bot credentials.
# The current adapter sends privacy notices only; it NEVER stores medical chat
# content, creates patient records, or serves as secure portal authentication.
# Set a PUBLIC HTTPS privacy notice before enabling. Redis required for
# deduplication. Never commit secrets, webhook headers or bot tokens.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Local polling: explicit test-only opt-in and exactly ONE paired private chat.
# Do not use for real patient data or production. Pair with the Windows setup script.
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLLING_TEST_MODE=false
TELEGRAM_POLLING_CHAT_ID=

# Persistent SQL outbox worker is OFF unless deliberately activated in the
# Docker "messaging" profile after provider/legal/consent approvals.
OUTBOUND_WORKER_ENABLED=false
OUTBOUND_WORKER_POLL_SECONDS=5
OUTBOUND_WORKER_BATCH_SIZE=20
