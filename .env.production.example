# Production environment. Copy to .env on the server, fill every value, keep it out of git.
# Generate secrets with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Generate 32-byte keys with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

APP_ENV=production
PUBLIC_DOMAIN=panel.example.com
PANEL_ENV_LABEL=محیط عملیاتی

# Database: owner account (migrations only) and the non-privileged runtime role used by the API.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
RLS_ENFORCEMENT=required
JWT_SECRET=

# Staff two-factor authentication (admin and operator are always required in production).
STAFF_MFA_REQUIRED=true
STAFF_MFA_ROLES=admin,operator
MFA_ENCRYPTION_KEY=

# Medical documents: MinIO (S3-compatible) + ClamAV, client-side envelope encryption.
DOCUMENT_PROCESSING_APPROVED=true
MEDICAL_STORAGE_SELF_HOSTED=true
MEDICAL_S3_ENCRYPTION=client
MEDICAL_S3_ENDPOINT=http://minio:9000
MEDICAL_S3_BUCKET=medtour-medical
MEDICAL_S3_REGION=us-east-1
MEDICAL_MASTER_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MEDICAL_DOCUMENT_RETENTION_DAYS=3650

# Patient one-time codes by email.
OTP_DELIVERY_PROVIDER=email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Encrypted backups. Store BACKUP_PASSPHRASE in a password manager OUTSIDE this server.
BACKUP_PASSPHRASE=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Legal decisions (references only; the documents themselves stay with the legal team).
PUBLIC_PRIVACY_NOTICE_URL=
PRIVACY_NOTICE_VERSION=
PRIVACY_NOTICE_APPROVAL_REFERENCE=
DATA_PROTECTION_REVIEW_REFERENCE=
PROVIDER_CONTRACTS_REFERENCE=
MEDICAL_TOURISM_LICENSE_REFERENCE=

# Telegram onboarding bot (webhook through Caddy: https://PUBLIC_DOMAIN/api/v1/webhooks/telegram).
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_OPERATOR_CONTACT_URL=
